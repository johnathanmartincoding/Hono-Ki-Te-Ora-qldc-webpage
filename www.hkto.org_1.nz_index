f86c79dc84cd.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" async=""></script><script src="/_next/static/chunks/69be39811437728d.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" async=""></script><script src="/_next/static/chunks/turbopack-ab9b30ad562c96a8.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" async=""></script><script src="/_next/static/chunks/c1bb687b5b3c47de.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" async=""></script><script src="/_next/static/chunks/ff1a16fafef87110.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" async=""></script><script src="/_next/static/chunks/d2be314c3ece3fbe.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" async=""></script><link rel="preload" href="https://www.googletagmanager.com/gtag/js?id=G-QE6H9GXP37" as="script"/><meta name="next-size-adjust" content=""/><title>Hono Ki Te Ora | Mental Health &amp; Wellbeing — Central Otago</title><meta name="description" content="Hono Ki Te Ora is a free mental health navigation and support service for young people and their whānau in Central Otago and the Queenstown Lakes district. A programme of ADL Limited."/><meta name="keywords" content="mental health,Central Otago,Queenstown,Wanaka,Cromwell,Alexandra,wellbeing,youth,support,ADL,Hono Ki Te Ora"/><meta property="og:title" content="Hono Ki Te Ora | Mental Health &amp; Wellbeing"/><meta property="og:description" content="Free mental health navigation and support for young people and whānau in Central Otago."/><meta property="og:url" content="https://hkto.org.nz"/><meta property="og:site_name" content="Hono Ki Te Ora"/><meta property="og:locale" content="en_NZ"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content="Hono Ki Te Ora | Mental Health &amp; Wellbeing"/><meta name="twitter:description" content="Free mental health navigation and support for young people and whānau in Central Otago."/><link rel="icon" href="/favicon.ico?favicon.0b3bf435.ico" sizes="256x256" type="image/x-icon"/><script src="/_next/static/chunks/a6dad97d9634a72d.js?dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U" noModule=""></script></head><body class="flex flex-col min-h-screen"><div hidden=""><!--$--><!--/$--></div><div class="bg-red-700 text-white text-sm py-2 px-4"><div class="max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-center"><span class="font-semibold">In an emergency call 111</span><span class="hidden sm:inline text-red-300">|</span><a href="tel:08004678462" class="flex items-center gap-1.5 hover:underline font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone w-3.5 h-3.5" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>Mental Health Crisis: 0800 467 846</a></div></div><header class="relative bg-white border-b border-slate-100 sticky top-0 z-50 shadow-sm"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex items-center justify-between h-24 py-2"><a class="flex items-center group" aria-label="Hono Ki Te Ora — An ADL Service" href="/"><img alt="Hono Ki Te Ora — An ADL Service" width="1500" height="1050" decoding="async" data-nimg="1" class="h-20 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Flogos%2Fhkto-logo.png&amp;w=1920&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1x, /_next/image?url=%2Flogos%2Fhkto-logo.png&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 2x" src="/_next/image?url=%2Flogos%2Fhkto-logo.png&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U"/></a><nav class="hidden md:flex items-center gap-1"><a class="px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-[#4A6E9A] text-white" href="/">Home</a><a class="px-3 py-2 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:text-[#4A6E9A] hover:bg-blue-50" href="/about">About</a><a class="px-3 py-2 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:text-[#4A6E9A] hover:bg-blue-50" href="/how-it-works">How It Works</a><a class="px-3 py-2 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:text-[#4A6E9A] hover:bg-blue-50" href="/for-referrers">For Referrers</a><a class="px-3 py-2 rounded-lg text-sm font-medium transition-colors text-slate-600 hover:text-[#4A6E9A] hover:bg-blue-50" href="/contact">Contact</a><a class="ml-2 px-4 py-2 bg-[#4A6E9A] hover:bg-[#3d5c82] text-white text-sm font-semibold rounded-lg transition-colors" href="/referral">Make a Referral</a></nav><button class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100" aria-label="Toggle menu"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu w-5 h-5" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></div></header><main class="flex-1"><section class="relative min-h-[90vh] flex items-center"><div class="absolute inset-0 overflow-hidden"><img alt="Turquoise lake framed by native bush in Central Otago" decoding="async" data-nimg="fill" class="object-cover object-center" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=640&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 640w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=750&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 750w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=828&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 828w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=1080&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1080w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=1200&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1200w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1920w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=2048&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 2048w, /_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 3840w" src="/_next/image?url=%2Fimages%2Flake-turquoise.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U"/><div class="absolute inset-0 bg-gradient-to-b from-[#4A6E9A]/60 via-[#17263a]/50 to-[#17263a]/85"></div></div><div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24"><div class="max-w-2xl"><p class="text-sky-300 font-medium text-sm uppercase tracking-widest mb-3">rarangahia ngā ara hauora</p><h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">Hono Ki Te Ora</h1><p class="text-xl sm:text-2xl text-white/90 font-light mb-4 italic">Connecting to wellbeing</p><p class="text-base sm:text-lg text-white/80 leading-relaxed mb-8">Free mental health and addiction navigation and support service for children and young people (5–24 years) and their whānau across Central Otago and the Queenstown Lakes district. We help you find your way.</p><div class="flex flex-wrap gap-4"><a class="inline-flex items-center gap-2 px-6 py-3.5 bg-white text-[#4A6E9A] font-semibold rounded-xl hover:bg-blue-50 transition-colors text-base" href="/contact">Connect to Support <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div></section><section class="py-20 bg-white"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-14"><h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">We&#x27;re here to help</h2><p class="text-lg text-slate-600 max-w-2xl mx-auto">Hono Ki Te Ora is your key point of connection — we listen, we help you understand your options, and we connect you to the right support at the right time.</p></div><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><div class="p-8 rounded-2xl bg-slate-50 hover:bg-[#eef2f8] transition-colors border border-slate-100"><div class="inline-flex p-3 bg-[#4A6E9A]/10 text-[#4A6E9A] rounded-xl mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-compass w-7 h-7" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"></path></svg></div><h3 class="text-lg font-bold text-slate-900 mb-2">Navigation Support</h3><p class="text-slate-600 text-sm leading-relaxed">Our Guides help you and your whānau understand what services are available and how to access them.</p></div><div class="p-8 rounded-2xl bg-slate-50 hover:bg-[#eef2f8] transition-colors border border-slate-100"><div class="inline-flex p-3 bg-[#4A6E9A]/10 text-[#4A6E9A] rounded-xl mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart w-7 h-7" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path></svg></div><h3 class="text-lg font-bold text-slate-900 mb-2">Clinical Intake</h3><p class="text-slate-600 text-sm leading-relaxed">Our Intake Clinicians assess needs, provide early support, and connect you to specialist mental health services when required.</p></div><div class="p-8 rounded-2xl bg-slate-50 hover:bg-[#eef2f8] transition-colors border border-slate-100"><div class="inline-flex p-3 bg-[#4A6E9A]/10 text-[#4A6E9A] rounded-xl mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-handshake w-7 h-7" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"></path><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"></path><path d="m21 3 1 11h-2"></path><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"></path><path d="M3 4h8"></path></svg></div><h3 class="text-lg font-bold text-slate-900 mb-2">Partnership Network</h3><p class="text-slate-600 text-sm leading-relaxed">We work closely with GPs, specialist mental health and community services.</p></div></div></div></section><section class="py-20 bg-[#f8f6f2]"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"><div><p class="text-[#4A6E9A] font-semibold text-sm uppercase tracking-wider mb-3">Who we&#x27;re here for</p><h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">Young people and whānau across our region</h2><p class="text-slate-600 leading-relaxed mb-6">We support children, youth and young adults aged 5–24 and their whānau who are experiencing mental health, addiction, or wellbeing challenges. Whether you&#x27;re struggling yourself, or worried about someone you love, we&#x27;re here.</p><ul class="space-y-3 mb-8"><li class="flex items-start gap-2.5 text-slate-700"><span class="mt-1 w-5 h-5 rounded-full bg-[#4A6E9A]/15 flex items-center justify-center shrink-0"><span class="w-2 h-2 rounded-full bg-[#4A6E9A]"></span></span>Children/Tamariki 5–12 years and their whānau</li><li class="flex items-start gap-2.5 text-slate-700"><span class="mt-1 w-5 h-5 rounded-full bg-[#4A6E9A]/15 flex items-center justify-center shrink-0"><span class="w-2 h-2 rounded-full bg-[#4A6E9A]"></span></span>Youth/Rangatahi 13–17 years</li><li class="flex items-start gap-2.5 text-slate-700"><span class="mt-1 w-5 h-5 rounded-full bg-[#4A6E9A]/15 flex items-center justify-center shrink-0"><span class="w-2 h-2 rounded-full bg-[#4A6E9A]"></span></span>Young adults 18–24 years</li><li class="flex items-start gap-2.5 text-slate-700"><span class="mt-1 w-5 h-5 rounded-full bg-[#4A6E9A]/15 flex items-center justify-center shrink-0"><span class="w-2 h-2 rounded-full bg-[#4A6E9A]"></span></span>Whānau and caregivers seeking guidance</li></ul><a class="inline-flex items-center gap-2 text-[#4A6E9A] font-semibold hover:gap-3 transition-all" href="/about">Learn more about us <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div><div class="relative h-80 lg:h-96 rounded-2xl overflow-hidden shadow-xl"><img alt="Group of young people celebrating outdoors in Central Otago" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=640&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 640w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=750&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 750w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=828&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 828w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=1080&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1080w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=1200&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1200w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1920w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=2048&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 2048w, /_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 3840w" src="/_next/image?url=%2Fimages%2Fgroup-hill.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U"/></div></div></div></section><section class="py-20 bg-[#17263a] text-white"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-14"><h2 class="text-3xl sm:text-4xl font-bold mb-4">Our kaupapa — our purpose</h2><p class="text-slate-300 text-lg max-w-2xl mx-auto">Hono Ki Te Ora is built on values that put people first — grounded in the landscape and communities we serve.</p></div><div class="grid grid-cols-2 md:grid-cols-4 gap-6"><div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center"><div class="inline-flex p-3 bg-white/10 text-sky-300 rounded-xl mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-6 h-6" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></div><h3 class="font-bold text-white mb-1">Culturally safe</h3><p class="text-slate-300 text-sm">Respecting all cultures and identities</p></div><div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center"><div class="inline-flex p-3 bg-white/10 text-sky-300 rounded-xl mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart w-6 h-6" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path></svg></div><h3 class="font-bold text-white mb-1">Strength-based</h3><p class="text-slate-300 text-sm">Building on what is already working</p></div><div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center"><div class="inline-flex p-3 bg-white/10 text-sky-300 rounded-xl mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-6 h-6" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></div><h3 class="font-bold text-white mb-1">Whānau centred</h3><p class="text-slate-300 text-sm">Family and community at the heart</p></div><div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center"><div class="inline-flex p-3 bg-white/10 text-sky-300 rounded-xl mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-6 h-6" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg></div><h3 class="font-bold text-white mb-1">Locally rooted</h3><p class="text-slate-300 text-sm">Right here in Central Otago</p></div></div></div></section><section class="py-20 bg-white"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-12"><h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Locally connected</h2><p class="text-slate-600 max-w-2xl mx-auto">We are part of these communities. We know the distances, the seasons, and the challenges of life across the Central Otago region.</p></div><div class="grid grid-cols-2 md:grid-cols-4 gap-3"><div class="relative h-52 rounded-xl overflow-hidden col-span-2"><img alt="Panoramic view of the Queenstown Lakes valley and river" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=640&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 640w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=750&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 750w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=828&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 828w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=1080&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1080w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=1200&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1200w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1920w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=2048&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 2048w, /_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 3840w" src="/_next/image?url=%2Fimages%2Fvalley-panorama.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U"/><div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 p-3"><span class="text-white text-sm font-medium">Queenstown Lakes</span></div></div><div class="relative h-52 rounded-xl overflow-hidden"><img alt="Lake gorge with boats on the water, Central Otago" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;heig