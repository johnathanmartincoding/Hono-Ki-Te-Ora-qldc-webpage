/image?url=%2Fimages%2Fwanaka-lake.jpg&amp;w=1200&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1200w, /_next/image?url=%2Fimages%2Fwanaka-lake.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 1920w, /_next/image?url=%2Fimages%2Fwanaka-lake.jpg&amp;w=2048&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 2048w, /_next/image?url=%2Fimages%2Fwanaka-lake.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U 3840w" src="/_next/image?url=%2Fimages%2Fwanaka-lake.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_FGZFoKPzrn4t1UPvmqQfgSLGDe2U"/><div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 p-3"><span class="text-white text-sm font-medium">Wānaka</span></div></div></div></div></section><section class="py-16 bg-[#4A6E9A]"><div class="max-w-3xl mx-auto px-4 text-center"><h2 class="text-3xl font-bold text-white mb-4">Ready to take the first step?</h2><p class="text-white/80 text-lg mb-8">Reach out to us — whether you need support yourself, or you&#x27;re looking for help for someone you care about. Our team is here.</p><div class="flex flex-wrap gap-4 justify-center"><a class="px-8 py-4 bg-white text-[#4A6E9A] font-bold rounded-xl hover:bg-blue-50 transition-colors" href="/contact">Get in Touch</a><a class="px-8 py-4 bg-transparent border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors" href="/for-referrers">Make a Referral</a></div></div></section><!--$--><!--/$--></main><footer class="bg-[#17263a] text-white"><div class="bg-red-800 px-4 py-4"><div class="max-w-6xl mx-auto text-center"><p class="font-semibold text-sm sm:text-base">In crisis? Call<!-- --> <a href="tel:111" class="underline font-bold">111</a> <!-- -->for emergencies  |  Mental Health Crisis:<!-- --> <a href="tel:08004678462" class="underline font-bold">0800 467 846</a> </p></div></div><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12"><div class="grid grid-cols-1 md:grid-cols-3 gap-10"><div><div class="flex items-center gap-3